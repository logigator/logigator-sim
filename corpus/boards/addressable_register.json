    { "tick": 4, "writes": [{ "comp": 0, "frames": [{ "state": [false, true, false, true, false, true] }] }] },
    { "tick": 7, "writes": [{ "comp": 0, "frames": [{ "state": [true, true, true, false, false, false] }] }] },
    { "tick": 10, "writes": [{ "comp": 0, "frames": [{ "state": [true, true, true, false, false, true] }] }] },
    { "tick": 13, "writes": [{ "comp": 0, "frames": [{ "state": [false, false, false, false, true, false] }] }] },
    { "tick": 16, "writes": [{ "comp": 0, "frames": [{ "state": [false, false, false, false, true, true] }] }] }
  ],
  "board": {
    "components": [
      { "type": 200, "outputs": [0, 1, 2, 3, 4, 5] },
      { "type": 204, "inputs": [0, 1, 2, 3, 4, 5], "outputs": [6, 7, 8, 9, 10, 11, 12, 13], "dataBus": 4 }
    ]
  }
}
