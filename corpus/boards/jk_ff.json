{
  "name": "jk_ff",
  "description": "JK flip-flop (type 14): J=link0, clk=link1, K=link2, Q=link3, Qbar=link4. Exercises set (J=1,K=0), toggle (J=1,K=1) and reset (J=0,K=1) across four rising edges. At tick 10 the clock AND K are written high in the same tick, so the FF is enqueued twice — its self-referential toggle must fire exactly once (edge_prev idempotency).",
  "ticks": 24,
  "inputWrites": [
    { "tick": 1, "writes": [{ "comp": 0, "frames": [{ "state": [true, false, false] }] }] },
    { "tick": 4, "writes": [{ "comp": 0, "frames": [{ "state": [true, true, false] }] }] },
    { "tick": 7, "writes": [{ "comp": 0, "frames": [{ "state": [true, false, false] }] }] },
    { "tick": 10, "writes": [{ "comp": 0, "frames": [{ "state": [true, true, true] }] }] },
    { "tick": 13, "writes": [{ "comp": 0, "frames": [{ "state": [true, false, true] }] }] },
    { "tick": 16, "writes": [{ "comp": 0, "frames": [{ "state": [true, true, true] }] }] },
    { "tick": 19, "writes": [{ "comp": 0, "frames": [{ "state": [false, false, true] }] }] },
    { "tick": 22, "writes": [{ "comp": 0, "frames": [{ "state": [false, true, true] }] }] }
  ],
  "board": {
    "components": [
      { "type": 200, "outputs": [0, 1, 2] },
      { "type": 14, "inputs": [0, 1, 2], "outputs": [3, 4] }
    ]
  }
}
