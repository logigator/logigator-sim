{
  "name": "adders",
  "description": "Half adder (type 10) and full adder (type 11) sharing a 3-bit UserInput (a=link0, b=link1, cin=link2). Walks input combinations to exercise both sum and carry outputs.",
  "ticks": 12,
  "inputWrites": [
    { "tick": 1, "writes": [{ "comp": 0, "frames": [{ "state": [true, false, false] }] }] },
    { "tick": 4, "writes": [{ "comp": 0, "frames": [{ "state": [true, true, false] }] }] },
    { "tick": 7, "writes": [{ "comp": 0, "frames": [{ "state": [true, true, true] }] }] },
    { "tick": 10, "writes": [{ "comp": 0, "frames": [{ "state": [false, true, true] }] }] }
  ],
  "board": {
    "components": [
      { "type": 200, "outputs": [0, 1, 2] },
      { "type": 10, "inputs": [0, 1], "outputs": [3, 4] },
      { "type": 11, "inputs": [0, 1, 2], "outputs": [5, 6] }
    ]
  }
}
