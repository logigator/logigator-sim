{
  "// note": "Type-checks the API contract against both generated bindings; emits nothing.",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "noUnusedLocals": true
  },
  "include": ["contract.d.ts", "contract.conformance.ts"]
}
